# Brand (runtime values are also served by the API at /api/v1/config)
VITE_APP_NAME=SafishaCon
# Leave empty to call the API on the same origin (/api/v1 is proxied by Vite in dev and nginx in Docker).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api to.
VITE_DEV_API_PROXY=http://localhost:8000
