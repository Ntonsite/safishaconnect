# ---------------------------------------------------------------------------
# SafishaCon environment. Copy to .env and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Environment ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# --- Brand (rename the product here; no code changes needed) ---
APP_NAME=SafishaCon
APP_TAGLINE=Book. We assign. We clean.
SUPPORT_EMAIL=support@safishacon.local
SUPPORT_PHONE=+255 700 000 000
SUPPORT_WHATSAPP=+255 700 000 000
OFFICE_ADDRESS=Dar es Salaam, Tanzania

# --- Locale & money ---
DEFAULT_CURRENCY=TZS
DEFAULT_LOCALE=en                  # en | sw
TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_COMMISSION_PERCENT=20      # initial value; admins change it in Settings

# --- Database (docker compose builds DATABASE_URL for the api container) ---
POSTGRES_DB=safishacon
POSTGRES_USER=safisha
POSTGRES_PASSWORD=safisha
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://safisha:safisha@localhost:5432/safishacon
# Pool per API process. Budget: containers x WEB_CONCURRENCY x (size + overflow) + worker < max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5          # then 503 SERVICE_BUSY (load shedding) instead of queueing forever
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-32-bytes-minimum
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Dev convenience for Flutter web / any localhost port. Must be empty in production.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?
AUTH_RATE_LIMIT_PER_MINUTE=20      # per IP and endpoint, per API process (login/register/refresh)
WRITE_RATE_LIMIT_PER_MINUTE=30     # per account: booking, review, complaint creation
# Proxies allowed to set X-Forwarded-For (IPs/CIDRs). Never "*" (production refuses it).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Server process (docker image) ---
WEB_CONCURRENCY=2                  # uvicorn processes per API container: one per vCPU
GRACEFUL_SHUTDOWN_SECONDS=20
KEEP_ALIVE_SECONDS=15

# --- Observability ---
METRICS_ENABLED=true               # GET /metrics (Prometheus). Not proxied by nginx.
METRICS_TOKEN=                     # set to require "Authorization: Bearer <token>" on /metrics
SLOW_REQUEST_MS=1000               # requests slower than this log a http.slow_request warning

# --- Marketplace operations ---
ASSIGNMENT_OFFER_TTL_MINUTES=30
MIN_BOOKING_LEAD_HOURS=2
MAX_BOOKING_DAYS_AHEAD=60
BOOKING_SLOT_START_HOUR=7
BOOKING_SLOT_END_HOUR=17
# true = run offer expiry + notification outbox inside the API (local dev). docker compose sets
# false for the API and runs the dedicated `worker` service instead.
BACKGROUND_JOBS_ENABLED=true
WORKER_INTERVAL_SECONDS=30

# --- Payments (cash always works; digital stays "coming soon" until integrated) ---
DIGITAL_PAYMENTS_ENABLED=false
MOBILE_MONEY_PROVIDER=
MOBILE_MONEY_API_KEY=

# --- Notifications (in-app always; SMS only when a provider is configured) ---
SMS_PROVIDER=
SMS_API_KEY=
NOTIFICATION_MAX_ATTEMPTS=5        # outbox retries (1, 2, 4, 8... minutes) before FAILED
# Applied by every outbound integration (SMS, payment gateway).
EXTERNAL_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_READ_TIMEOUT_SECONDS=10

# --- Demo data (must be false in production) ---
DEMO_MODE=true
SEED_DEMO_PASSWORD=Safisha@2026
RUN_SEED=true

# --- Ports ---
API_PORT=8000
WEB_PORT=8080
# Web build: leave empty to call /api on the same origin (nginx proxies it).
VITE_API_BASE_URL=
